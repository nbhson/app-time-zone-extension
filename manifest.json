{
    "name": "Convert Time",
    "version": "1.3.0",
    "manifest_version": 3,
    "description": "Display the time of countries beautifully.",
    "icons": {
        "16": "images/icon.png",
        "48": "images/icon.png"
    },
    "action": {
        "default_icon": {
            "19": "images/icon.png",
            "38": "images/icon.png"
        },
        "default_title": "Convert Time",
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage",
        "clipboardWrite"
    ]
}